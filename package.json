{
  "name": "ng-mat-select-infinite-scroll",
  "version": "6.0.0",
  "scripts": {
    "ng": "ng",
    "format": "prettier --write \"tools/**/*.mjs\" \"tools/**/package.json\" \"projects/ng-mat-select-infinite-scroll/src/**/*.ts\"",
    "format:check": "prettier --check \"tools/**/*.mjs\" \"tools/**/package.json\" \"projects/ng-mat-select-infinite-scroll/src/**/*.ts\"",
    "start": "npm --prefix projects/example start",
    "build": "node tools/build-library/build.mjs",
    "build:workspace": "ng build ng-mat-select-infinite-scroll",
    "compat:generate": "node tools/generate-consumers.mjs",
    "compat:check": "node tools/check-compatibility.mjs",
    "develop": "ng build ng-mat-select-infinite-scroll --watch --configuration development",
    "test": "npm run test:unit",
    "test:unit": "ng test ng-mat-select-infinite-scroll --watch=false --browsers=ChromeHeadless",
    "check:policy": "node tools/check-policy.mjs",
    "release:check": "node tools/verify-release.mjs",
    "npm_pack": "npm pack ./dist/ng-mat-select-infinite-scroll --pack-destination dist",
    "package": "npm run build",
    "build:example": "npm --prefix projects/example run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "~15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/material": "~15.2.9",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular/cli": "~15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^15.2.2",
    "prettier": "3.10.1",
    "typescript": "~4.9.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HaidarZ/ng-mat-select-infinite-scroll.git"
  },
  "overrides": {
    "piscina": "4.9.4",
    "tar": "7.5.23",
    "proxy-addr": "2.0.8",
    "websocket-driver": "0.7.5"
  }
}
